    "VoiceInk app is not available" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk-App ist nicht verfügbar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk App 不可用"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application VoiceInk n'est pas disponible"
          }
        }
      }
    },
    "VoiceInk automatically understands what you are working with and selects your preferred setup. You can always configure this by editing or creating new modes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk erkennt automatisch, woran du arbeitest, und wählt deine bevorzugte Konfiguration aus. Du kannst dies jederzeit anpassen, indem du Modi bearbeitest oder neue erstellst."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk 会自动识别你正在处理的内容，并选用你偏好的设置。你随时可以通过编辑或创建新模式来进行配置。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk comprend automatiquement avec quoi vous travaillez et sélectionne votre configuration préférée. Vous pouvez toujours configurer cela en modifiant ou en créant de nouveaux modes."
          }
        }
      }
    },
    "VoiceInk automatically learns from the corrections you make to improve transcription accuracy over time. Dictionary Auto Learn uses your currently configured AI provider and AI model. You can change them anytime in Dictionary Settings." : {
      "comment" : "Description of Dictionary Auto Learn in the What's New panel.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk lernt automatisch aus deinen Korrekturen, um die Transkriptionsgenauigkeit mit der Zeit zu verbessern. Die automatische Wörterbucherweiterung verwendet deinen derzeit konfigurierten KI-Anbieter und dein KI-Modell. Du kannst beides jederzeit in den Wörterbucheinstellungen ändern."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk 会自动学习你所做的更正，从而逐步提高转录准确度。词典自动学习会使用你当前配置的 AI 提供商和 AI 模型。你可以随时在“词典”设置中更改它们。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk apprend automatiquement des corrections que vous apportez pour améliorer la précision de la transcription au fil du temps. Dictionary Auto Learn utilise votre fournisseur d'IA et votre modèle d'IA actuellement configurés. Vous pouvez les modifier à tout moment dans les paramètres du dictionnaire."
          }
        }
      }
    },
    "VoiceInk can select the right mode from the app you are using and the rules you configure." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk kann anhand der verwendeten App und der konfigurierten Regeln den passenden Modus auswählen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk 可以根据你正在使用的 App 和你配置的规则选择合适的模式。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk peut sélectionner le bon mode à partir de l'application que vous utilisez et des règles que vous configurez."
          }
        }
      }
    },
    "VoiceInk could not switch to another microphone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk konnte nicht zu einem anderen Mikrofon wechseln."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk 无法切换到其他麦克风。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk n'a pas pu passer à un autre microphone."
          }
        }
      }
    },
    "VoiceInk couldn't access its storage location. Your transcriptions will not be saved between sessions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk konnte nicht auf den Speicherort zugreifen. Deine Transkriptionen werden nicht zwischen Sitzungen gespeichert."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk 无法访问其存储位置。你的转写记录将无法跨会话存储。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk n'a pas pu accéder à son emplacement de stockage. Vos transcriptions ne seront pas enregistrées entre les sessions."
          }
        }
      }
    },
    "VoiceInk couldn't access the macOS Keychain. Quit and reopen VoiceInk. If the problem continues, restart your Mac." : {
      "comment" : "Error message displayed when the macOS Keychain is unavailable.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk konnte nicht auf den macOS-Schlüsselbund zugreifen. Beende VoiceInk und öffne die App erneut. Falls das Problem weiterhin besteht, starte deinen Mac neu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk 无法访问 macOS 钥匙串。请退出并重新打开 VoiceInk。如果问题仍然存在，请重新启动 Mac。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk n'a pas pu accéder au trousseau macOS. Quittez et rouvrez VoiceInk. Si le problème persiste, redémarrez votre Mac."
          }
        }
      }
    },
