          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk がほかのマイクに切り替えられませんでした。"
          }
        }
      }
    },
    "VoiceInk couldn't access its storage location. Your transcriptions will not be saved between sessions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk konnte nicht auf den Speicherort zugreifen. Deine Transkriptionen werden nicht zwischen Sitzungen gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk n'a pas pu accéder à son emplacement de stockage. Vos transcriptions ne seront pas enregistrées entre les sessions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk 无法访问其存储位置。你的转写记录将无法跨会话存储。"
