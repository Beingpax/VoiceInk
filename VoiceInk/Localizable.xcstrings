    "These corrections conflict with existing word replacements. Review your dictionary and try again." : {
      "comment" : "Shown when a grouped Auto Learn suggestion conflicts with saved word replacements.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Korrekturen stehen im Konflikt mit vorhandenen Textersetzungen. Überprüfe dein Wörterbuch und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces corrections sont en conflit avec des remplacements de mots existants. Vérifiez votre dictionnaire et réessayez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些更正与现有的词语替换规则冲突。请检查词典后重试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この修正内容は、既存の自動置換と重複しています。辞書を確認して、もう一度お試しください。"
          }
        }
      }
    },
    "These estimated tokens are a rough estimate of token usage. They are not exact token counts or provider-reported billing usage." : {
      "comment" : "Explains that model usage token totals are approximate and not billing-grade provider counts.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese geschätzten Tokens sind eine grobe Schätzung der Token-Nutzung. Sie sind keine exakten Token-Zahlen und keine vom Anbieter gemeldete Abrechnungsnutzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These estimated tokens are a rough estimate of token usage. They are not exact token counts or provider-reported billing usage."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces jetons estimés constituent une estimation approximative de l’utilisation des jetons. Il ne s’agit pas d’un nombre exact de jetons ni d’une utilisation de facturation déclarée par le fournisseur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些估算令牌只是对令牌使用量的粗略估计，并非精确的令牌数量，也不是提供商报告的计费用量。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このトークン数はおおよその目安です。正確なトークン数や、提供元が報告する課金対象の使用量ではありません。"
          }
        }
      }
    },
