    "Set how long to wait for batch cloud transcription to finish. This does not affect local or realtime transcription." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt fest, wie lange auf den Abschluss einer Cloud-Batch-Transkription gewartet wird. Dies hat keine Auswirkungen auf lokale Transkriptionen oder Echtzeittranskriptionen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez le temps d'attente pour la fin de la transcription cloud par lots. Cela n'affecte pas la transcription locale ou en temps réel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置等待云端批量转写完成的时长。此设置不会影响本地转写或实时转写。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウドでの一括文字起こしの完了を待つ時間を設定します。ローカルやリアルタイムの文字起こしには影響しません。"
          }
        }
      }
    },
    "Set how long to wait for the AI provider to respond. If no response is received within this duration, you can either fail immediately and paste the original transcription, or retry the request up to 3 attempts." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, wie lange auf eine Antwort des KI-Anbieters gewartet werden soll. Wenn innerhalb dieser Dauer keine Antwort eingeht, kannst du entweder sofort abbrechen und die ursprüngliche Transkription einfügen oder die Anfrage bis zu 3-mal wiederholen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez le temps d'attente pour que le fournisseur d'IA réponde. Si aucune réponse n'est reçue dans ce délai, vous pouvez soit échouer immédiatement et coller la transcription originale, soit réessayer la demande jusqu'à 3 tentatives."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置等待 AI 提供商响应的时长。如果在该时长内未收到响应，你可以选择立即失败并粘贴原始转写内容，或重试请求（最多 3 次）。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIプロバイダの応答を待つ時間を設定します。時間内に応答がない場合は、すぐに中止して元の文字起こしを貼り付けるか、最大3回まで再試行するかを選べます。"
          }
        }
      }
    },
    "Set how VoiceInk transcribes and formats your speech, then start dictating in any app." : {
      "comment" : "Description of the empty state shown before the user creates a mode.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, wie VoiceInk deine Sprache transkribiert und formatiert, und diktiere dann in jeder App."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez la manière dont VoiceInk transcrit et formate votre discours, puis commencez à dicter dans n'importe quelle application."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 VoiceInk 如何转写和格式化你的语音，然后即可在任何 App 中开始听写。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInkでの文字起こしと整え方を設定すれば、どのアプリでも音声入力を始められます。"
          }
        }
      }
    },
