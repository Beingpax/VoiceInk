        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk n'a pas pu passer à un autre microphone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk 无法切换到其他麦克风。"
