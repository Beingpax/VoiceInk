        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vocabulaire aide les modèles de transcription pris en charge et l'amélioration de l'IA à préserver les noms importants, les termes techniques et les orthographes uniques."
