    "Automatically learns corrections you make after dictation." : {
      "comment" : "Explains the purpose of Dictionary Auto Learn.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernt automatisch aus Korrekturen, die du nach dem Diktieren vornimmst."
          }
        },
        "zh-Hans" : {
