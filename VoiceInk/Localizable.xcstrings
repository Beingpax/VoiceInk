      }
    },
    "Automatically presses a key combination after pasting text. Useful for chat applications or forms that use different send shortcuts." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drückt nach dem Einfügen automatisch eine Tastenkombination. Nützlich für Chat-Apps oder Formulare mit abweichenden Sendekürzeln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuie automatiquement sur une combinaison de touches après avoir collé du texte. Utile pour les applications de chat ou les formulaires qui utilisent différents raccourcis d'envoi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴文本后自动按下组合键。适用于使用不同发送快捷键的聊天 App 或表单。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストを貼り付けたあと、指定したキーの組み合わせを自動で押します。送信キーがアプリごとに異なるチャットアプリや入力フォームで便利です。"
          }
        }
      }
    },
    "Automatically remove configured filler words like 'uh', 'um', or 'hmm' from transcriptions. If no filler words are configured, this cleanup is skipped." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurierte Füllwörter wie „ähm“, „äh“ oder „hmm“ automatisch aus Transkriptionen entfernen. Wenn keine Füllwörter konfiguriert sind, wird diese Bereinigung übersprungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez automatiquement les mots de remplissage configurés tels que « euh », « um » ou « hmm » des transcriptions. Si aucun mot de remplissage n’est configuré, ce nettoyage est ignoré."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动从转写中移除已配置的填充词，例如「uh」「um」或「hmm」。如果未配置任何填充词，将跳过此清理。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字起こしから「えー」「あの」「うーん」などの登録済みのつなぎ言葉を自動で取り除きます。つなぎ言葉が登録されていない場合、この処理は行われません。"
          }
        }
      }
    },
    "Automatically skip AI enhancement when the transcription has very few words. Short phrases like \"yes\", \"thank you\", or quick commands don't benefit from enhancement." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Verbesserung automatisch überspringen, wenn die Transkription sehr wenige Wörter enthält. Kurze Phrasen wie „ja“, „danke“ oder schnelle Befehle profitieren nicht von der Verbesserung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorez automatiquement l’amélioration de l’IA lorsque la transcription contient très peu de mots. Les phrases courtes comme « oui », « merci » ou les commandes rapides ne bénéficient pas d'améliorations."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当转写内容字数很少时，自动跳过 AI 润色。「是的」「谢谢」之类的简短用语或快速指令并不能从润色中获益。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字起こしの語数がごく少ないときは、AI補正を自動でスキップします。「はい」「ありがとう」のような短い言葉や簡単なコマンドは、補正してもあまり変わらないためです。"
          }
        }
      }
    },
