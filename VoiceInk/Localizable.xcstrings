          }
        }
      }
    },
    "VoiceInk couldn't access the macOS Keychain. Quit and reopen VoiceInk. If the problem continues, restart your Mac." : {
      "comment" : "Error message displayed when the macOS Keychain is unavailable.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk konnte nicht auf den macOS-Schlüsselbund zugreifen. Beende VoiceInk und öffne die App erneut. Falls das Problem weiterhin besteht, starte deinen Mac neu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk n'a pas pu accéder au trousseau macOS. Quittez et rouvrez VoiceInk. Si le problème persiste, redémarrez votre Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk 无法访问 macOS 钥匙串。请退出并重新打开 VoiceInk。如果问题仍然存在，请重新启动 Mac。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceInk が macOS のキーチェーンにアクセスできませんでした。VoiceInk を終了して開き直してください。それでも解決しない場合は、Macを再起動してください。"
          }
        }
      }
    },
