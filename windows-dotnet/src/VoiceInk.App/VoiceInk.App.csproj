<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>VoiceInk</AssemblyName>
    <RootNamespace>VoiceInk.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationIcon>Assets\voiceink.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PublishReadyToRun Condition="'$(PublishAot)' != 'true'">true</PublishReadyToRun>
    <BaseOutputPath Condition="'$(PublishProfile)' == 'NativeAOT'">bin\aot\</BaseOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Self-contained Windows App SDK needs Windows build tools; CI turns it on, cross-compiling elsewhere leaves it off. -->
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VoiceInk.Core\VoiceInk.Core.csproj" />
    <ProjectReference Include="..\VoiceInk.Platform\VoiceInk.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\voiceink.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
